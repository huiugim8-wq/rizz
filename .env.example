# Development: copy to .env.local. AWS EC2: inject from /etc/rizz/app.env.
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Google Cloud Console OAuth 2.0 web client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This verified Google account becomes the first OWNER on its first successful sign-in.
INITIAL_OWNER_EMAIL=
DATABASE_URL=postgresql://rizz_dev:rizz_local_only@127.0.0.1:55437/rizz_homepage
# Optional, for migrations only. Never expose to app/browser.
MIGRATION_DATABASE_URL=
# Use an absolute persistent path outside the release directory in production.
UPLOAD_ROOT=
TEST_DATABASE_URL=postgresql://rizz_dev:rizz_local_only@127.0.0.1:55437/rizz_homepage_test
# Backup only; use a separate DB role and external repository.
BACKUP_DATABASE_URL=
BACKUP_STAGING_ROOT=
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
