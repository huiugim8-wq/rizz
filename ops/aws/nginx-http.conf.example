# Temporary HTTP configuration for validating a new EC2 deployment before a
# domain and TLS certificate are connected. Replace this with
# nginx.conf.example once DNS is ready.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 12m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location ~ "^/uploads/([a-f0-9]{64}\.webp)$" {
        alias /var/lib/rizz/uploads/public/$1;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    location /uploads/ {
        return 404;
    }

    location /_next/static/ {
        alias /opt/rizz/current/.next/static/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /video/ {
        alias /opt/rizz/current/public/video/;
        add_header Cache-Control "public, max-age=3600";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
